{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KVM Client",
  "version": "0.1.0",
  "identifier": "local.kvm.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "KVM Client",
      "width": 1280,
      "height": 900,
      "minWidth": 1000,
      "minHeight": 650,
      "backgroundColor": "#0b0e14"
    }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false }
}
