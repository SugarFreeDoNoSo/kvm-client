{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KVM Client",
  "version": "0.1.0",
  "identifier": "local.kvm.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "KVM Client",
      "width": 1280,
      "height": 900,
      "minWidth": 1000,
      "minHeight": 650,
      "backgroundColor": "#0b0e14"
    }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../LICENSE": "licenses/KVM-Client-COPYING",
      "vendor/moonlight-common/LICENSE": "licenses/moonlight-common-COPYING",
      "vendor/moonlight-common/UPSTREAM.md": "licenses/moonlight-common-UPSTREAM.md",
      "src/shaders/THIRD_PARTY_NOTICES.md": "licenses/SGSR.md"
    }
  }
}
